# Demo (default): synthetic targets, email previews only, no API key required.
APP_MODE=demo
DATA_DIR=./data
APP_BASE_URL=http://localhost:8000
EMAIL_TRANSPORT=preview

# Live mode: copy this file to .env.local, set APP_MODE=live and a separate DATA_DIR.
# APP_MODE=live
# DATA_DIR=./data-live

# Postgres instead of SQLite (for example a Neon connection string)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional research (manual sources work without a key)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Email (live sends only when APP_MODE=live). Resend is the simplest:
# EMAIL_TRANSPORT=resend
# EMAIL_FROM=waymark@your-domain.com
# RESEND_API_KEY=

# Or SMTP, with EMAIL_TRANSPORT=smtp and EMAIL_FROM set
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_STARTTLS=true
# SMTP_SSL=false

# Remote access: terminate TLS in front of the app and set APP_BASE_URL to the https:// origin.
# If that proxy appends to X-Forwarded-For, set how many such proxies there are (Cloud Run: 1).
# TRUSTED_PROXY_HOPS=0

# A worker started on a schedule (python -m waymark.worker --once) needs more
# slack before the app calls it stopped than one that runs continuously.
# WORKER_STALE_MINUTES=5
